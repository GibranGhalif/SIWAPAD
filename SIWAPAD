        // ==================== FIREBASE ONLINE DATABASE ====================
        
        // Open Firebase Settings Modal
        function openFirebaseModal() {
            document.getElementById('firebaseModal').classList.add('active');
            
            // Load saved config
            if (firebaseConfig) {
                document.getElementById('firebaseApiKey').value = firebaseConfig.apiKey || '';
                document.getElementById('firebaseAuthDomain').value = firebaseConfig.authDomain || '';
                document.getElementById('firebaseProjectId').value = firebaseConfig.projectId || '';
                document.getElementById('firebaseStorageBucket').value = firebaseConfig.storageBucket || '';
                document.getElementById('firebaseMessagingSenderId').value = firebaseConfig.messagingSenderId || '';
                document.getElementById('firebaseAppId').value = firebaseConfig.appId || '';
                document.getElementById('autoSync').checked = firebaseConfig.autoSync || false;
            }
            
            updateConnectionStatus();
        }

        function closeFirebaseModal() {
            document.getElementById('firebaseModal').classList.remove('active');
        }

        // Firebase Form Submit
        document.getElementById('firebaseForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const config = {
                apiKey: document.getElementById('firebaseApiKey').value.trim(),
                authDomain: document.getElementById('firebaseAuthDomain').value.trim(),
                projectId: document.getElementById('firebaseProjectId').value.trim(),
                storageBucket: document.getElementById('firebaseStorageBucket').value.trim(),
                messagingSenderId: document.getElementById('firebaseMessagingSenderId').value.trim(),
                appId: document.getElementById('firebaseAppId').value.trim(),
                autoSync: document.getElementById('autoSync').checked
            };
            
            // Validate required fields
            if (!config.apiKey || !config.projectId) {
                showToast('API Key dan Project ID wajib diisi!', 'error');
                return;
            }
            
            firebaseConfig = config;
            localStorage.setItem('firebaseConfig', JSON.stringify(config));
            
            showToast('Konfigurasi Firebase berhasil disimpan!', 'success');
            initializeFirebase();
        });

        // Initialize Firebase
        async function initializeFirebase() {
            if (!isFirebaseConfigured()) return;
            
            try {
                showSyncBanner('Menghubungkan ke Firebase...');
                
                // Load Firebase SDKs dynamically
                await loadFirebaseSDKs();
                
                // Initialize Firebase
                if (typeof firebase !== 'undefined') {
                    const app = firebase.initializeApp(firebaseConfig);
                    db = firebase.firestore();
                    auth = firebase.auth();
                    
                    // Enable offline persistence
                    await db.enablePersistence({ synchronizeTabs: true });
                    
                    isOnline = true;
                    document.getElementById('syncMenuItem').innerHTML = `
                        <svg class="w-5 h-5 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Sinkronisasi Online
                    `;
                    
                    showToast('Berhasil terhubung ke Firebase!', 'success');
                    hideSyncBanner();
                    
                    // Listen for connection changes
                    window.addEventListener('online', () => syncPendingData());
                    window.addEventListener('offline', () => {
                        isOnline = false;
                        showToast('Koneksi terputus. Data akan disinkronkan saat online.', 'warning');
                    });
                    
                    // Initial sync
                    await syncFromFirebase();
                }
            } catch (error) {
                console.error('Firebase initialization error:', error);
                showConnectionStatus('error', 'Gagal terhubung: ' + error.message);
                showToast('Gagal terhubung ke Firebase', 'error');
                hideSyncBanner();
            }
        }

        // Load Firebase SDKs
        function loadFirebaseSDKs() {
            return new Promise((resolve, reject) => {
                if (typeof firebase !== 'undefined') {
                    resolve();
                    return;
                }
                
                const scripts = [
                    'https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js',
                    'https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js',
                    'https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js'
                ];
                
                let loaded = 0;
                
                scripts.forEach(src => {
                    const script = document.createElement('script');
                    script.src = src;
                    script.onload = () => {
                        loaded++;
                        if (loaded === scripts.length) resolve();
                    };
                    script.onerror = () => reject(new Error('Failed to load Firebase SDK'));
                    document.head.appendChild(script);
                });
            });
        }

        // Sync to Firebase
        async function syncToFirebase(collection, data) {
            if (!isOnline || !db) return;
            
            try {
                showSyncBanner(`Menyinkronkan ${collection}...`);
                
                const batch = db.batch();
                const collectionRef = db.collection(collection);
                
                if (Array.isArray(data)) {
                    data.forEach(item => {
                        const docRef = collectionRef.doc(String(item.id));
                        batch.set(docRef, {
                            ...item,
                            _syncedAt: firebase.firestore.FieldValue.serverTimestamp()
                        }, { merge: true });
                    });
                } else {
                    const docRef = collectionRef.doc(String(data.id));
                    batch.set(docRef, {
                        ...data,
                        _syncedAt: firebase.firestore.FieldValue.serverTimestamp()
                    }, { merge: true });
                }
                
                await batch.commit();
                hideSyncBanner();
                return true;
            } catch (error) {
                console.error('Sync error:', error);
                pendingWrites.push({ collection, data });
                showToast('Gagal sinkronisasi. Data akan dicoba lagi nanti.', 'warning');
                hideSyncBanner();
                return false;
            }
        }

        // Sync from Firebase
        async function syncFromFirebase() {
            if (!isOnline || !db) return;
            
            try {
                showSyncBanner('Memuat data dari Firebase...');
                
                // Sync wajibPajak
                const wpSnapshot = await db.collection('wajibPajak').get();
                const wpData = wpSnapshot.docs.map(doc => doc.data());
                if (wpData.length > 0) {
                    wajibPajak = wpData;
                    localStorage.setItem('wajibPajak', JSON.stringify(wajibPajak));
                }
                
                // Sync users
                const usersSnapshot = await db.collection('users').get();
                const usersData = usersSnapshot.docs.map(doc => doc.data());
                if (usersData.length > 0) {
                    users = usersData;
                    localStorage.setItem('users', JSON.stringify(users));
                }
                
                // Sync realisasi
                const realisasiSnapshot = await db.collection('realisasi').get();
                const realisasiData = realisasiSnapshot.docs.map(doc => doc.data());
                if (realisasiData.length > 0) {
                    realisasiPajak = realisasiData;
                    localStorage.setItem('realisasiPajak', JSON.stringify(realisasiPajak));
                }
                
                // Sync target
                const targetSnapshot = await db.collection('targetPajak').get();
                const targetData = targetSnapshot.docs.map(doc => doc.data());
                if (targetData.length > 0) {
                    targetPajak = targetData;
                    localStorage.setItem('targetPajak', JSON.stringify(targetPajak));
                }
                
                hideSyncBanner();
                showToast('Data berhasil disinkronisasi dari Firebase!', 'success');
                
                // Update UI
                updateDashboard();
                updateWPTable();
                updateUserTable();
                updateRealisasiSummary();
                updateRealisasiTable();
            } catch (error) {
                console.error('Sync from Firebase error:', error);
                showToast('Gagal memuat data dari Firebase', 'error');
                hideSyncBanner();
            }
        }

        // Sync pending data
        async function syncPendingData() {
            if (!isOnline || pendingWrites.length === 0) return;
            
            const writes = [...pendingWrites];
            pendingWrites = [];
            
            for (const write of writes) {
                await syncToFirebase(write.collection, write.data);
            }
        }

        // Manual sync
        async function manualSync() {
            if (!isFirebaseConfigured()) {
                showToast('Silakan konfigurasi Firebase terlebih dahulu', 'warning');
                openFirebaseModal();
                return;
            }
            
            if (!isOnline) {
                await initializeFirebase();
            }
            
            await syncToFirebase('wajibPajak', wajibPajak);
            await syncToFirebase('users', users);
            await syncToFirebase('realisasi', realisasiPajak);
            await syncToFirebase('targetPajak', targetPajak);
            
            showToast('Sinkronisasi manual selesai!', 'success');
        }

        // Test connection
        async function testConnection() {
            const apiKey = document.getElementById('firebaseApiKey').value.trim();
            const projectId = document.getElementById('firebaseProjectId').value.trim();
            
            if (!apiKey || !projectId) {
                showToast('API Key dan Project ID wajib diisi!', 'error');
                return;
            }
            
            showConnectionStatus('info', 'Menguji koneksi...');
            
            try {
                // Try to connect to Firestore
                const response = await fetch(`https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents`, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${apiKey}`
                    }
                });
                
                if (response.ok) {
                    showConnectionStatus('success', 'Koneksi Firebase berhasil!');
                    showToast('Koneksi Firebase berhasil!', 'success');
                } else {
                    throw new Error('Gagal terhubung ke Firebase');
                }
            } catch (error) {
                showConnectionStatus('error', 'Koneksi gagal: ' + error.message);
                showToast('Koneksi Firebase gagal!', 'error');
            }
        }

        // Update connection status
        function updateConnectionStatus() {
            const statusEl = document.getElementById('connectionStatus');
            if (!statusEl) return;
            
            if (isFirebaseConfigured()) {
                statusEl.classList.remove('hidden');
                if (isOnline) {
                    statusEl.className = 'text-center py-2 rounded text-sm bg-green-100 text-green-700';
                    statusEl.textContent = '✓ Terhubung ke Firebase';
                } else {
                    statusEl.className = 'text-center py-2 rounded text-sm bg-yellow-100 text-yellow-700';
                    statusEl.textContent = '⚠ Terkonfigurasi tapi belum terhubung';
                }
            } else {
                statusEl.classList.add('hidden');
            }
        }

        function showConnectionStatus(type, message) {
            const statusEl = document.getElementById('connectionStatus');
            if (!statusEl) return;
            
            statusEl.classList.remove('hidden');
            if (type === 'success') {
                statusEl.className = 'text-center py-2 rounded text-sm bg-green-100 text-green-700';
            } else if (type === 'error') {
                statusEl.className = 'text-center py-2 rounded text-sm bg-red-100 text-red-700';
            } else {
                statusEl.className = 'text-center py-2 rounded text-sm bg-blue-100 text-blue-700';
            }
            statusEl.textContent = message;
        }

        // Show/Hide sync banner
        function showSyncBanner(message) {
            const banner = document.getElementById('syncBanner');
            document.getElementById('syncStatusText').textContent = message;
            banner.classList.remove('hidden');
        }

        function hideSyncBanner() {
            document.getElementById('syncBanner').classList.add('hidden');
        }

        // Override save functions to include sync
        const originalSaveWP = function() {
            localStorage.setItem('wajibPajak', JSON.stringify(wajibPajak));
            if (isOnline && firebaseConfig?.autoSync) {
                syncToFirebase('wajibPajak', wajibPajak);
            }
        };

        const originalSaveUsers = function() {
            localStorage.setItem('users', JSON.stringify(users));
            if (isOnline && firebaseConfig?.autoSync) {
                syncToFirebase('users', users);
            }
        };

        const originalSaveRealisasi = function() {
            localStorage.setItem('realisasiPajak', JSON.stringify(realisasiPajak));
            if (isOnline && firebaseConfig?.autoSync) {
                syncToFirebase('realisasi', realisasiPajak);
            }
        };

        const originalSaveTarget = function() {
            localStorage.setItem('targetPajak', JSON.stringify(targetPajak));
            if (isOnline && firebaseConfig?.autoSync) {
                syncToFirebase('targetPajak', targetPajak);
            }
        };

        // Initialize Firebase on page load if configured
        document.addEventListener('DOMContentLoaded', function() {
            const savedUser = localStorage.getItem('currentUser');
            if (savedUser) {
                currentUser = JSON.parse(savedUser);
                document.getElementById('loginPage').classList.add('hidden');
                document.getElementById('mainApp').classList.remove('hidden');
                document.getElementById('userName').textContent = currentUser.fullName;
                document.getElementById('userInitial').textContent = currentUser.fullName.charAt(0).toUpperCase();
                initializeApp();
            }
            
            // Auto-initialize Firebase if configured
            if (isFirebaseConfigured()) {
                setTimeout(() => initializeFirebase(), 1000);
            }
        });
    </script>
</body>
