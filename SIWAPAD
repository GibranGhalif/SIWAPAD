        document.getElementById('realisasiForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const id = document.getElementById('realisasiId').value;
            const data = {
                id: id ? parseInt(id) : Date.now(),
                npwpd: document.getElementById('realisasiNpwpd').value,
                nama_wp: document.getElementById('realisasiNamaWP').value,
                jenis_pajak: document.getElementById('realisasiJenisPajak').value,
                tahun: parseInt(document.getElementById('realisasiTahun').value),
                periode: document.getElementById('realisasiPeriode').value,
