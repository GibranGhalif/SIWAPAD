        // Calculate Pajak
        function calculatePajak() {
            const dasarPengenaan = parseFloat(document.getElementById('realisasiDasarPengenaan').value) || 0;
            const tarif = parseFloat(document.getElementById('realisasiTarif').value) || 0;
            const jumlahPajak = (dasarPengenaan * tarif) / 100;
            document.getElementById('realisasiJumlahPajak').value = Math.round(jumlahPajak);
            calculateTotal();
        }

        // Calculate Total
        function calculateTotal() {
            const jumlahPajak = parseFloat(document.getElementById('realisasiJumlahPajak').value) || 0;
            const denda = parseFloat(document.getElementById('realisasiDenda').value) || 0;
            document.getElementById('realisasiTotal').value = jumlahPajak + denda;
        }

