            };
            
            if (id) {
                const index = realisasiPajak.findIndex(r => r.id === parseInt(id));
                if (index !== -1) {
                    realisasiPajak[index] = { ...realisasiPajak[index], ...data, updated_at: new Date().toISOString() };
                }
            } else {
                realisasiPajak.push(data);
