        // Update Realisasi Summary
        function updateRealisasiSummary() {
            const tahun = parseInt(document.getElementById('filterTahun')?.value) || new Date().getFullYear();
            const currentMonth = new Date().toLocaleString('id-ID', { month: 'long' }).toLowerCase();
            
            // Get target total
            const targetTotal = targetPajak
                .filter(t => t.tahun === tahun)
                .reduce((sum, t) => sum + t.nominal, 0);
            
            // Realisasi tahun berjalan
            const realisasiTahun = realisasiPajak
                .filter(r => r.tahun === tahun && r.status === 'lunas')
                .reduce((sum, r) => sum + r.total, 0);
            
            // Realisasi bulan ini
            const realisasiBulan = realisasiPajak
                .filter(r => r.tahun === tahun && r.periode === currentMonth && r.status === 'lunas')
                .reduce((sum, r) => sum + r.total, 0);
            
            // Persentase
            const persentase = targetTotal > 0 ? ((realisasiTahun / targetTotal) * 100).toFixed(1) : 0;
            
            document.getElementById('targetTahun').textContent = formatRupiah(targetTotal);
            document.getElementById('realisasiBulan').textContent = formatRupiah(realisasiBulan);
            document.getElementById('realisasiTahun').textContent = formatRupiah(realisasiTahun);
            document.getElementById('persentase').textContent = persentase + '%';
        }

