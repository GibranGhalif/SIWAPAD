    <script>
        // Initialize Data
        let wajibPajak = JSON.parse(localStorage.getItem('wajibPajak')) || [];
        let users = JSON.parse(localStorage.getItem('users')) || [
            { id: 1, username: 'admin', fullName: 'Administrator', email: 'admin@sidrap.go.id', password: 'admin123', role: 'admin', status: 'aktif' },
            { id: 2, username: 'operator', fullName: 'Operator Pajak', email: 'operator@sidrap.go.id', password: 'operator123', role: 'operator', status: 'aktif' }
        ];
        let currentUser = null;
        let currentPage = 1;

        // Firebase Configuration & State
        let firebaseConfig = JSON.parse(localStorage.getItem('firebaseConfig')) || null;
        let db = null;
        let auth = null;
        let isOnline = false;
        let pendingWrites = [];
        
        // Check if Firebase is configured
        function isFirebaseConfigured() {
            return firebaseConfig !== null && 
                   firebaseConfig.apiKey && 
                   firebaseConfig.projectId;
        }
        const perPage = 10;
        let map = null;
        let blockMap = null;
        let miniMap = null;
        let miniMapMarker = null;
        let mapMarker = null;
        let tempLocation = { lat: -3.7333, lng: 119.8833 }; // Default Sidrap coordinates
        let standardLayer = null;
        let satelliteLayer = null;
        let currentMapLayer = 'standard';

        // Tax types mapping
        const taxTypes = {
            reklame: 'Pajak Reklame',
            air_tanah: 'Pajak Air Tanah',
            sarang_burung: 'Pajak Sarang Burung Walet',
            mineral: 'Pajak Mineral Bukan Logam & Batuan',
            pbb: 'PBB-P2',
            bphtb: 'BPHTB',
            pbjt_mamin: 'PBJT - Makanan & Minuman',
            pbjt_listrik: 'PBJT - Tenaga Listrik',
            pbjt_hotel: 'PBJT - Perhotelan',
            pbjt_parkir: 'PBJT - Parkir',
            pbjt_hiburan: 'PBJT - Kesenian & Hiburan',
            opsen_pkb: 'Opsen PKB',
            opsen_bbnkb: 'Opsen BBNKB'
        };

        // Page titles
        const pageTitles = {
            dashboard: 'Dashboard',
            inputWP: 'Input Wajib Pajak',
            dataWP: 'Data Wajib Pajak',
            petaBlok: 'Peta Blok',
            realisasi: 'Realisasi Pajak',
            users: 'Manajemen User'
        };

        // Login Form
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value;
            
            console.log('Login attempt:', { username, userCount: users.length, users: users.map(u => ({ username: u.username, status: u.status })) });
            
            const user = users.find(u => u.username === username && u.password === password && u.status === 'aktif');
            
            console.log('Found user:', user);
            
            if (user) {
                currentUser = user;
                document.getElementById('loginPage').classList.add('hidden');
                document.getElementById('mainApp').classList.remove('hidden');
                document.getElementById('userName').textContent = user.fullName;
                document.getElementById('userInitial').textContent = user.fullName.charAt(0).toUpperCase();
                localStorage.setItem('currentUser', JSON.stringify(user));
                initializeApp();
                showToast('Login berhasil!', 'success');
            } else {
                // Check specific error
                const userExists = users.find(u => u.username === username);
                if (!userExists) {
                    showToast('Username tidak ditemukan!', 'error');
                } else if (userExists.status !== 'aktif') {
                    showToast('User tidak aktif!', 'error');
                } else {
                    showToast('Password salah!', 'error');
                }
            }
        });

        // Logout
        function logout() {
            currentUser = null;
            localStorage.removeItem('currentUser');
            document.getElementById('mainApp').classList.add('hidden');
            document.getElementById('loginPage').classList.remove('hidden');
            document.getElementById('username').value = '';
            document.getElementById('password').value = '';
        }

        // Initialize App
        function initializeApp() {
            updateDashboard();
            updateWPTable();
            updateUserTable();
            initializeMiniMap();
            initializeBlockMap();
            updateDashboardRealisasi();
            updateRealisasiSummary();
            updateRealisasiTable();
            updateDate();
        }

        // Update Date
        function updateDate() {
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('currentDate').textContent = new Date().toLocaleDateString('id-ID', options);
        }

        // Show Page
        function showPage(page) {
            document.querySelectorAll('.page').forEach(p => p.classList.add('hidden'));
            document.getElementById(page + 'Page').classList.remove('hidden');
            document.querySelectorAll('.sidebar-item').forEach(item => item.classList.remove('active'));
            document.querySelector(`[data-page="${page}"]`).classList.add('active');
            document.getElementById('pageTitle').textContent = pageTitles[page];
            
            if (page === 'petaBlok' && blockMap) {
                setTimeout(() => blockMap.invalidateSize(), 100);
            }
        }

        // Show Tax Fields
        function showTaxFields() {
            const checkboxes = document.querySelectorAll('input[name="jenis_pajak"]:checked');
            document.querySelectorAll('.tax-field').forEach(field => field.classList.add('hidden'));
            
            checkboxes.forEach(cb => {
                const fieldMap = {
                    reklame: 'fieldReklame',
                    air_tanah: 'fieldAirTanah',
                    sarang_burung: 'fieldSarangBurung',
                    mineral: 'fieldMineral',
                    pbb: 'fieldPBB',
                    bphtb: 'fieldBPHTB',
                    pbjt_mamin: 'fieldPbjtMamin',
                    pbjt_listrik: 'fieldPbjtListrik',
                    pbjt_hotel: 'fieldPbjtHotel',
                    pbjt_parkir: 'fieldPbjtParkir',
                    pbjt_hiburan: 'fieldPbjtHiburan',
                    opsen_pkb: 'fieldOpsenPKB',
                    opsen_bbnkb: 'fieldOpsenBBNKB'
                };
                if (fieldMap[cb.value]) {
                    document.getElementById(fieldMap[cb.value]).classList.remove('hidden');
                }
            });
        }

        // Initialize Mini Map
        function initializeMiniMap() {
            if (document.getElementById('miniMap')) {
                miniMap = L.map('miniMap').setView([-3.7333, 119.8833], 10);
                
                // Define layers
                const miniStandard = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap'
                });
                const miniSatellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                    attribution: '© Esri'
                });
                
                // Add standard layer by default
                miniStandard.addTo(miniMap);
                
                // Add layer control
                const baseMaps = {
                    "Standard": miniStandard,
                    "Satelit": miniSatellite
                };
                L.control.layers(baseMaps, null, { position: 'bottomright' }).addTo(miniMap);
            }
        }

        // Initialize Block Map
        function initializeBlockMap() {
            if (document.getElementById('blockMap')) {
                blockMap = L.map('blockMap').setView([-3.7333, 119.8833], 10);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors'
                }).addTo(blockMap);
                
                // Add sample layer
                const sampleLayer = L.layerGroup().addTo(blockMap);
                const samplePolygon = L.polygon([
                    [-3.73, 119.87],
                    [-3.73, 119.89],
                    [-3.75, 119.89],
                    [-3.75, 119.87]
                ], { color: 'blue', fillColor: 'blue', fillOpacity: 0.2 }).bindPopup('Blok Contoh');
                sampleLayer.addLayer(samplePolygon);
                
                document.getElementById('totalBlocks').textContent = '1';
                document.getElementById('activeLayers').textContent = '1';
            }
        }

        // Open Map Modal
        function openMapModal() {
            document.getElementById('mapModal').classList.add('active');
            setTimeout(() => {
                if (!map) {
                    map = L.map('map').setView([-3.7333, 119.8833], 12);
                    
                    // Define map layers
                    standardLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '© OpenStreetMap contributors'
                    });
                    
                    satelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                        attribution: '© Esri'
                    });
                    
                    // Add standard layer by default
                    standardLayer.addTo(map);
                    
                    // Add click event handler
                    map.on('click', function(e) {
                        if (mapMarker) {
                            map.removeLayer(mapMarker);
                        }
                        mapMarker = L.marker([e.latlng.lat, e.latlng.lng]).addTo(map);
                        document.getElementById('modalLat').value = e.latlng.lat.toFixed(7);
                        document.getElementById('modalLng').value = e.latlng.lng.toFixed(7);
                        tempLocation = { lat: e.latlng.lat, lng: e.latlng.lng };
                    });
                } else {
                    map.invalidateSize();
                }
            }, 100);
        }

        // Close Map Modal
        function closeMapModal() {
            document.getElementById('mapModal').classList.remove('active');
        }

        // Confirm Location
        function confirmLocation() {
            document.getElementById('latitude').value = tempLocation.lat.toFixed(7);
            document.getElementById('longitude').value = tempLocation.lng.toFixed(7);
            
            if (miniMap) {
                miniMap.setView([tempLocation.lat, tempLocation.lng], 15);
                if (miniMapMarker) {
                    miniMap.removeLayer(miniMapMarker);
                }
                miniMapMarker = L.marker([tempLocation.lat, tempLocation.lng]).addTo(miniMap);
            }
            
            closeMapModal();
        }

        // Locate User
        function locateUser() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;
                    map.setView([lat, lng], 15);
                    if (mapMarker) {
                        map.removeLayer(mapMarker);
                    }
                    mapMarker = L.marker([lat, lng]).addTo(map);
                    document.getElementById('modalLat').value = lat.toFixed(7);
                    document.getElementById('modalLng').value = lng.toFixed(7);
                    tempLocation = { lat, lng };
                }, function() {
                    showToast('Gagal mendapatkan lokasi', 'error');
                });
            }
        }

        // Go to Sidrap
        function goToSidrap() {
            const sidrapCoords = [-3.7333, 119.8833];
            map.setView(sidrapCoords, 11);
            if (mapMarker) {
                map.removeLayer(mapMarker);
            }
            mapMarker = L.marker(sidrapCoords).addTo(map);
            document.getElementById('modalLat').value = sidrapCoords[0].toFixed(7);
            document.getElementById('modalLng').value = sidrapCoords[1].toFixed(7);
            tempLocation = { lat: sidrapCoords[0], lng: sidrapCoords[1] };
        }

        // Set Map Layer
        function setMapLayer(layerType) {
            if (!map || !standardLayer || !satelliteLayer) return;
            
            // Remove current layer
            if (currentMapLayer === 'standard') {
                map.removeLayer(standardLayer);
            } else {
                map.removeLayer(satelliteLayer);
            }
            
            // Add new layer
            if (layerType === 'standard') {
                standardLayer.addTo(map);
                currentMapLayer = 'standard';
                document.getElementById('btnStandard').className = 'px-3 py-2 bg-green-500 hover:bg-green-600 text-white rounded-lg text-sm font-medium';
                document.getElementById('btnSatellite').className = 'px-3 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded-lg text-sm font-medium';
            } else {
                satelliteLayer.addTo(map);
                currentMapLayer = 'satellite';
                document.getElementById('btnSatellite').className = 'px-3 py-2 bg-green-500 hover:bg-green-600 text-white rounded-lg text-sm font-medium';
                document.getElementById('btnStandard').className = 'px-3 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded-lg text-sm font-medium';
            }
            
            showToast(`Tampilan peta diubah ke ${layerType === 'standard' ? 'Standard' : 'Satelit'}`, 'success');
        }

        // Import File
        function importFile(input) {
            const file = input.files[0];
            if (file) {
                const fileName = file.name.toLowerCase();
                if (fileName.endsWith('.shp') || fileName.endsWith('.zip') || fileName.endsWith('.kmz') || fileName.endsWith('.kml')) {
                    document.getElementById('layerInfo').innerHTML = `
                        <div class="space-y-2">
                            <p><span class="font-medium">Nama File:</span> ${file.name}</p>
                            <p><span class="font-medium">Ukuran:</span> ${(file.size / 1024).toFixed(2)} KB</p>
                            <p><span class="font-medium">Status:</span> <span class="text-green-600">Berhasil diimpor (Simulasi)</span></p>
                            <p class="text-yellow-600 text-xs">Catatan: Import SHP/KML membutuhkan library tambahan seperti shapefile.js untuk implementasi penuh.</p>
                        </div>
                    `;
                    
                    // Add sample layer for visualization
                    const randomLayer = L.layerGroup().addTo(blockMap);
                    const colors = ['red', 'green', 'blue', 'orange', 'purple'];
                    for (let i = 0; i < 5; i++) {
                        const lat = -3.7 + (Math.random() * 0.2);
                        const lng = 119.85 + (Math.random() * 0.1);
                        const color = colors[Math.floor(Math.random() * colors.length)];
                        const polygon = L.polygon([
                            [lat, lng],
                            [lat + 0.02, lng],
                            [lat + 0.02, lng + 0.02],
                            [lat, lng + 0.02]
                        ], { color: color, fillColor: color, fillOpacity: 0.3 }).bindPopup(`Blok ${i + 1}`);
                        randomLayer.addLayer(polygon);
                    }
                    
                    document.getElementById('totalBlocks').textContent = parseInt(document.getElementById('totalBlocks').textContent) + 5;
                    document.getElementById('totalArea').textContent = (parseFloat(document.getElementById('totalArea').textContent) + Math.random() * 100).toFixed(2);
                    document.getElementById('activeLayers').textContent = parseInt(document.getElementById('activeLayers').textContent) + 1;
                    
                    showToast('File berhasil diimpor!', 'success');
                } else {
                    showToast('Format file tidak didukung!', 'error');
                }
            }
        }

        // Clear Map
        function clearMap() {
            if (blockMap) {
                blockMap.eachLayer(function(layer) {
                    if (layer instanceof L.Polygon || layer instanceof L.LayerGroup) {
                        blockMap.removeLayer(layer);
                    }
                });
            }
            document.getElementById('totalBlocks').textContent = '0';
            document.getElementById('totalArea').textContent = '0';
            document.getElementById('activeLayers').textContent = '0';
            document.getElementById('layerInfo').innerHTML = '<p>Belum ada layer yang dimuat. Import file SHP atau KMZ/KML untuk memulai.</p>';
            showToast('Peta berhasil dibersihkan!', 'success');
        }

