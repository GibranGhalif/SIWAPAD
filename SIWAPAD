                <div class="px-4 py-2 mt-4 text-xs text-white/50 uppercase tracking-wider">Realisasi Pajak</div>
                <a href="#" onclick="showPage('realisasi')" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm" data-page="realisasi">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    Realisasi Pajak
                </a>
                <div class="px-4 py-2 mt-4 text-xs text-white/50 uppercase tracking-wider">Pengaturan</div>
                <a href="#" onclick="showPage('users')" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm" data-page="users">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    Manajemen User
                </a>
                <a href="#" onclick="openFirebaseModal()" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4m0 5c0 2.21 3.582 4-8 4s-8-1.79-8-4"/></svg>
                    Database Online
                </a>
                <a href="#" onclick="manualSync()" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm" id="syncMenuItem">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    Sinkronisasi Data
                </a>
                <a href="#" onclick="logout()" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm text-red-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    Keluar
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="ml-64 min-h-screen">
            <!-- Header -->
            <header class="bg-white shadow-sm px-6 py-4 flex items-center justify-between sticky top-0 z-40">
                <div>
                    <h2 id="pageTitle" class="text-xl font-semibold text-gray-800">Dashboard</h2>
                    <p class="text-sm text-gray-500">Sistem Informasi Wajib Pajak Daerah</p>
                </div>
                <div class="flex items-center gap-4">
                    <span class="text-sm text-gray-600" id="currentDate"></span>
                    <div class="flex items-center gap-2 bg-gray-100 px-3 py-2 rounded-lg">
                        <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white font-semibold text-sm" id="userInitial">A</div>
                        <span class="text-sm font-medium" id="userName">Admin</span>
                    </div>
                </div>
            </header>

            <!-- Dashboard Page -->
            <div id="dashboardPage" class="page p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                    <div class="bg-white rounded-xl p-6 shadow-sm card-hover transition-all">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-500">Total Wajib Pajak</p>
                                <p class="text-2xl font-bold text-gray-800" id="totalWP">0</p>
                            </div>
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl p-6 shadow-sm card-hover transition-all">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-500">Pajak Reklame</p>
                                <p class="text-2xl font-bold text-green-600" id="totalReklame">0</p>
                            </div>
                            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl p-6 shadow-sm card-hover transition-all">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-500">PBB-P2</p>
                                <p class="text-2xl font-bold text-orange-600" id="totalPBB">0</p>
                            </div>
                            <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl p-6 shadow-sm card-hover transition-all">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-500">BPHTB</p>
                                <p class="text-2xl font-bold text-purple-600" id="totalBPHTB">0</p>
                            </div>
                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Realisasi Summary on Dashboard -->
                <div class="bg-gradient-to-r from-blue-600 to-blue-800 rounded-xl shadow-sm p-6 mb-6 text-white">
                    <h3 class="text-lg font-semibold mb-4">Ringkasan Realisasi Pajak Tahun ${new Date().getFullYear()}</h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <div>
                            <p class="text-sm text-blue-100 mb-1">Target Pajak</p>
                            <p class="text-2xl font-bold" id="dashboardTarget">Rp 0</p>
                        </div>
                        <div>
                            <p class="text-sm text-blue-100 mb-1">Realisasi Tahun Berjalan</p>
                            <p class="text-2xl font-bold text-green-300" id="dashboardRealisasi">Rp 0</p>
                        </div>
                        <div>
                            <p class="text-sm text-blue-100 mb-1">Sisa Target</p>
                            <p class="text-2xl font-bold text-yellow-300" id="dashboardSisa">Rp 0</p>
                        </div>
                        <div>
                            <p class="text-sm text-blue-100 mb-1">Pencapaian</p>
                            <p class="text-2xl font-bold text-white" id="dashboardPersentase">0%</p>
                        </div>
                    </div>
                    <div class="mt-4">
                        <div class="w-full bg-blue-900 rounded-full h-3">
                            <div class="h-3 rounded-full bg-green-400 transition-all duration-500" id="dashboardProgress" style="width: 0%"></div>
                        </div>
                    </div>
                </div>

                <!-- Tax Summary -->
                <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Ringkasan Wajib Pajak per Jenis</h3>
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4" id="taxSummary">
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="bg-white rounded-xl shadow-sm p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Wajib Pajak Terbaru</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left font-medium text-gray-600">NPWPD</th>
                                    <th class="px-4 py-3 text-left font-medium text-gray-600">Nama Wajib Pajak</th>
                                    <th class="px-4 py-3 text-left font-medium text-gray-600">Jenis Pajak</th>
                                    <th class="px-4 py-3 text-left font-medium text-gray-600">Tanggal Daftar</th>
                                </tr>
                            </thead>
                            <tbody id="recentWPTable">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Input Wajib Pajak Page -->
            <div id="inputWPPage" class="page hidden p-6">
                <div class="bg-white rounded-xl shadow-sm p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-6">Form Input Wajib Pajak</h3>
                    <form id="wpForm" class="space-y-6">
                        <!-- Data Dasar Wajib Pajak -->
                        <div class="border border-gray-200 rounded-lg p-4">
                            <h4 class="font-medium text-gray-800 mb-4 flex items-center gap-2">
                                <span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-bold">1</span>
                                Data Dasar Wajib Pajak
                            </h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">NPWPD *</label>
                                    <input type="text" name="npwpd" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" placeholder="Nomor Pokok Wajib Pajak Daerah" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Nama Wajib Pajak *</label>
                                    <input type="text" name="nama" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" placeholder="Nama lengkap" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">NIK / No. KTP *</label>
                                    <input type="text" name="nik" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" placeholder="Nomor KTP" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Jenis Wajib Pajak *</label>
                                    <select name="jenis_wp" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" required>
                                        <option value="">Pilih Jenis</option>
                                        <option value="perorangan">Perorangan</option>
                                        <option value="badan_usaha">Badan Usaha</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Nomor Telepon *</label>
                                    <input type="tel" name="telepon" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" placeholder="08xxxxxxxxxx" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                                    <input type="email" name="email" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" placeholder="email@example.com">
                                </div>
                            </div>
                        </div>

                        <!-- Alamat -->
                        <div class="border border-gray-200 rounded-lg p-4">
                            <h4 class="font-medium text-gray-800 mb-4 flex items-center gap-2">
                                <span class="w-8 h-8 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-bold">2</span>
                                Alamat Wajib Pajak
                            </h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Alamat Lengkap *</label>
                                    <textarea name="alamat" rows="2" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" placeholder="Jalan, RT/RW, Kelurahan, Kecamatan" required></textarea>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Desa/Kelurahan *</label>
                                    <input type="text" name="kelurahan" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Kecamatan *</label>
                                    <input type="text" name="kecamatan" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Kabupaten/Kota *</label>
                                    <input type="text" name="kabupaten" value="Sidenreng Rappang" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Provinsi *</label>
                                    <input type="text" name="provinsi" value="Sulawesi Selatan" class="input-field w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none" required>
                                </div>
                            </div>
                        </div>

                        <!-- Koordinat -->
